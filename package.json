{
  "name": "splitpair",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply splitpair --local",
    "db:migrate:remote": "wrangler d1 migrations apply splitpair --remote",
    "deploy": "wrangler d1 migrations apply splitpair --remote && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
